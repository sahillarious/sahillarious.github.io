# --- Search backend -------------------------------------------------------
# Recommended: a free Serper.dev key (reliable Google SERP API).
# Without it, the pipeline falls back to scraping google.com directly, which
# Google rate-limits / CAPTCHAs quickly.
SERPER_API_KEY=
SEARCH_PROVIDER=auto          # auto | serper | google_html

# --- Search tuning --------------------------------------------------------
SEARCH_RECENCY=w              # google qdr token: h48 | d | w | m
PAGES_PER_QUERY=2

# --- Filters --------------------------------------------------------------
MAX_AGE_DAYS=3
REQUIRE_EXPLICIT_JUNIOR=false # true = title must say junior/new-grad/etc.

# --- Politeness -----------------------------------------------------------
REQUEST_DELAY=2.0
MAX_ENRICH_WORKERS=4

# --- Output ---------------------------------------------------------------
OUTPUT_DIR=output
